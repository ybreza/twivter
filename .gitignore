scripts/*.cmd

# scratch logs written by those helpers
.build-next.log
.build-opennext.log
.tsc.log
.tsc-app.log
.tsc-worker.log
.seed.log
.verify.log
.verify-remote.log
.d1-check.log
.tail.log


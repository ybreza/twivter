# env files (can opt-in for committing if needed)
.env*
!.env.example

# Cloudflare Workers / D1 / R2
.wrangler/
.open-next/
.dev.vars
.dev.vars.*
!.dev.vars.example
cloudflare-env.d.ts

# local-only Windows helpers; each one hardcodes an absolute path and just

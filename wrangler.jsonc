{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "./worker.ts",
  "name": "twivter",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "twivter"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_USER",
        "class_name": "ChatUser"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatUser"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "twivter-db",
      "database_id": "bb94f5ca-aa44-4973-a851-170d10d21c99",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "twivter-media"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "twivter-cache"
    }
  ],
  "vars": {
    "NEXTJS_ENV": "production"
  },
  // Custom domain. `custom_domain` makes Cloudflare create and manage the DNS
  // record, which only works while the zone lives in this same account.
  // `workers_dev` stays enabled so the *.workers.dev URL keeps working and the
  // old hostname does not break while the certificate is still issuing.
  "routes": [
    {
      "pattern": "twivter.lamuri.biz.id",
      "custom_domain": true
    }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  }
}
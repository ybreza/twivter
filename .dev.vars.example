# Copy to `.dev.vars` for local development, then fill in the values.
# `.dev.vars` is git-ignored — never commit real secrets.

# Signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# Comma-separated origins allowed to open the chat WebSocket.
CHAT_ALLOWED_ORIGINS="http://localhost:3000"